@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h5" Class="mt-1">@brand</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudAppBar Elevation="1" Fixed="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-2">@title</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Color="Color.Inherit" Underline="Underline.None">
                <MudMenuItem Label="About" />
            </MudLink>
        </MudMenu>
    </MudAppBar>

    <MudMainContent Class="content overflow-auto pa-6">
        <CascadingValue Value="brand">
            <CascadingValue Value="onPageLoaded">
                @Body
            </CascadingValue>
        </CascadingValue>
    </MudMainContent>
</MudLayout>
